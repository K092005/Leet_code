class Solution {
public:
    int countBinarySubstrings(string s) {
        int result = 0;
        int prev = 0;
        int curr = 1;
        for (int i=1;i< s.size();i++){
            if(s[i] == s[i-1]){
                curr++;
            }else {
                prev = curr;
                curr = 1;
            }
                if(curr <= prev){
                    result++;
                }
            }
        

        return result;
    }
};
