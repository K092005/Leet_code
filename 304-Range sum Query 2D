class NumMatrix {
    vector<vector<int>>prefMatrix;
public:
    NumMatrix(vector<vector<int>>& matrix) {
        // we will be creating our pref matrix
        int rows = matrix.size();
        int cols = matrix[0].size();

        // resizing our prefMatrix
        prefMatrix.resize(rows, vector<int>(cols));

        for(int r = 0; r < rows; r++)
            for(int c = 0; c < cols; c++)
            {
                int result = matrix[r][c];
                if(r - 1 >= 0) result += prefMatrix[r - 1][c];
                if(c - 1 >= 0) result += prefMatrix[r][c-1];
                if(r - 1 >= 0 && c - 1 >= 0) result -= prefMatrix[r-1][c-1];

                prefMatrix[r][c] = result;
            }
        
    }
    
    int sumRegion(int row1, int col1, int row2, int col2) {
        int result = prefMatrix[row2][col2];
        if(row1 - 1 >= 0)
            result -= prefMatrix[row1 - 1][col2];
        if(col1 - 1 >= 0)
            result -= prefMatrix[row2][col1 - 1];

        if(row1 - 1 >= 0 && col1 - 1 >= 0)
            result += prefMatrix[row1 - 1][col1 - 1];
        
        return result;
    }
};

