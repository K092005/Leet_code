class Solution {
public:
    int maxArea(vector<int>& arr) {
        int i = 0, j = arr.size() - 1;
        int res = 0;

        while (i < j) {
            int amount = min(arr[i], arr[j]) * (j - i);  
            res = max(res, amount);

            
            if (arr[i] < arr[j])
                i++;
            else
                j--;
        }
        return res;
    }
};

